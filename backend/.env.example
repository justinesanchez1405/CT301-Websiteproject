# Copy this file to .env and fill in real values. Never commit .env.
# config/settings.py reads these values at startup.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string
# True while developing on your own computer, False on a real server.
DEBUG=True
# Comma-separated host names the site may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Database: "sqlite" (default, zero setup) or "mysql".
DB_ENGINE=sqlite
# The settings below are only used when DB_ENGINE=mysql.
DB_NAME=tehillim
DB_USER=tehillim_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
